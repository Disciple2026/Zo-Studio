# Copier en .env.local et renseigner. Ne jamais versionner de vraie valeur.

# Public (visible dans le navigateur) — la sécurité repose sur les règles RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement — jamais préfixé NEXT_PUBLIC_, jamais importé dans un composant client
SUPABASE_SERVICE_ROLE_KEY=

# Médias — à renseigner seulement quand le fournisseur aura été choisi (phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Fourni par le workflow GitHub Pages, vide ailleurs
PAGES_BASE_PATH=
